{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "default_agent": "build",
  "shell": "/bin/zsh",
  "permission": {
    "bash": {
      "*": "allow",
      "git push *": "ask"
    }
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "timeout": 600000
    },
    "blackbird": {
      "type": "remote",
      "url": "http://127.0.0.1:8081",
      "timeout": 600000
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": false
    },
    "kit": {
      "type": "local",
      "command": ["uvx", "--from", "cased-kit", "kit-dev-mcp"],
      "enabled": false,
      "timeout": 600000
    }
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 20000
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "watcher": {
    "ignore": ["**/.git/**", "**/node_modules/**"]
  },
  "provider": {
    "opencode": {
      "models": {
        "x-preview-f-free": {
          "name": "Ox Alpha Free (ZDR)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 131072 },
          "modalities": { "input": ["text", "image", "video"], "output": ["text"] },
          "status": "beta"
        }
      }
    },
    "openrouter": {
      "models": {
        "stealth/ox-alpha": {
          "name": "Ox Alpha (retained upstream)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 131072 },
          "modalities": { "input": ["text", "image", "video"], "output": ["text"] },
          "status": "beta"
        }
      }
    },
    "ox-command": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Command Code — Ox Alpha",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1",
        "apiKey": "{env:COMMAND_CODE_API_KEY}"
      },
      "models": {
        "stealth/ox-alpha": {
          "name": "Ox Alpha (not ZDR)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 131072 },
          "modalities": { "input": ["text", "image", "video"], "output": ["text"] },
          "status": "beta"
        }
      }
    },
    "ox-nous": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nous Portal — Ox Alpha",
      "options": {
        "baseURL": "http://127.0.0.1:8645/v1",
        "apiKey": "{env:NOUS_API_KEY}"
      },
      "models": {
        "stealth/ox-alpha": {
          "name": "Ox Alpha (enable Privacy Mode)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 131072 },
          "modalities": { "input": ["text", "image", "video"], "output": ["text"] },
          "status": "beta"
        }
      }
    },
    "ox-venice": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Venice — Ox Alpha",
      "options": {
        "baseURL": "https://api.venice.ai/api/v1",
        "apiKey": "{env:VENICE_API_KEY}"
      },
      "models": {
        "stealth-ox-alpha": {
          "name": "Ox Alpha (anonymized)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 131072 },
          "modalities": { "input": ["text", "image", "video"], "output": ["text"] },
          "status": "beta"
        }
      }
    }
  },
  "plugin": [
    [
      "blackbird-opencode@0.1.3",
      {
        "baseUrl": "http://127.0.0.1:8080",
        "projectKey": "~/workspace/blackbird",
        "agentName": "OpenCode",
        "routing": { "mode": "conversation", "agent": "build" }
      }
    ]
  ],
  "references": {
    "conventions": {
      "path": "~/dotfiles/docs",
      "description": "Dotfiles substrate conventions, workflow playbooks, architecture and perf docs; consult for git workflow, zsh, and tooling questions"
    }
  }
}
