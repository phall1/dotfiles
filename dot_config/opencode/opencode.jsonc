{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "default_agent": "build",
  "shell": "/bin/zsh",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ],
  "mcp": {
    "timeout": {
      "startup": 45000,
      "catalog": 30000,
      "execution": 600000
    },
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "blackbird": {
        "type": "remote",
        "url": "http://127.0.0.1:8081"
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true
      },
      "kit": {
        "type": "local",
        "command": ["uvx", "--from", "cased-kit", "kit-dev-mcp"],
        "disabled": true
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 20000
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "watcher": {
    "ignore": ["**/.git/**", "**/node_modules/**"]
  },
  "plugins": [
    {
      "package": "blackbird-opencode@0.1.2",
      "options": {
        "baseUrl": "http://127.0.0.1:8080",
        "projectKey": "~/workspace/blackbird",
        "agentName": "OpenCodePush",
        "routing": { "mode": "conversation", "agent": "OpenCodePush" }
      }
    }
  ],
  "references": {
    "conventions": {
      "path": "~/dotfiles/docs",
      "description": "Dotfiles substrate conventions, workflow playbooks, architecture and perf docs; consult for git workflow, zsh, and tooling questions"
    }
  }
}
