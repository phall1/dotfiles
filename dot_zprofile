# ============================================================================
# Platform-specific initialization
# ============================================================================

# Detect OS once and store it
export DOTFILES_OS="${DOTFILES_OS:-$(uname -s | tr '[:upper:]' '[:lower:]')}"

# Nix setup (Determinate Nix, official installer, single-user, multi-user)
for nix_profile in \
  /etc/profile.d/nix.sh \
  "$HOME/.nix-profile/etc/profile.d/nix.sh" \
  /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh

do
  if [[ -f "$nix_profile" ]]; then
    source "$nix_profile"
    break
  fi
done

# macOS-specific setup
if [[ "$DOTFILES_OS" == "darwin" ]]; then
  # Homebrew setup. `brew shellenv` is the single most expensive fork in shell
  # startup here — 19.9ms measured via xtrace through the first prompt. Its
  # output is pure static text (exports + an fpath prepend; every path is
  # absolute and it never interpolates the *current* PATH), so it is safe to
  # cache and replay. Regenerated whenever the brew binary is newer than the
  # cache, which covers upgrades and prefix changes.
  for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x "$_brew" ]] || continue
    _brew_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/brew-shellenv.zsh"
    if [[ ! -s "$_brew_cache" || "$_brew" -nt "$_brew_cache" ]]; then
      mkdir -p "${_brew_cache:h}" 2>/dev/null
      # temp+rename: never leave a half-written cache for the next shell
      if "$_brew" shellenv >| "$_brew_cache.$$" 2>/dev/null && [[ -s "$_brew_cache.$$" ]]; then
        mv -f "$_brew_cache.$$" "$_brew_cache" 2>/dev/null
      else
        rm -f "$_brew_cache.$$" 2>/dev/null
      fi
    fi
    if [[ -s "$_brew_cache" ]]; then
      source "$_brew_cache"
    else
      eval "$("$_brew" shellenv)"   # cache unwritable — fall back to the fork
    fi
    break
  done
  unset _brew _brew_cache

  # Use GNU coreutils over BSD versions
  if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
    export PATH="$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"
  fi
fi

# Linux-specific setup
if [[ "$DOTFILES_OS" == "linux" ]]; then
  # Ensure local bin is in PATH
  export PATH="$HOME/.local/bin:$PATH"
fi

# Note: Completions moved to .zshrc - compdef requires completion system to be initialized first

# OrbStack. Its installer appends this block to the live ~/.zprofile, which
# meant every `chezmoi apply` silently deleted it and broke the `orb`/`docker`
# CLI integration until the next OrbStack launch re-added it. Owned here so the
# source is authoritative and re-running the installer is a no-op.
[[ -f "$HOME/.orbstack/shell/init.zsh" ]] && \
  source "$HOME/.orbstack/shell/init.zsh" 2>/dev/null || :

