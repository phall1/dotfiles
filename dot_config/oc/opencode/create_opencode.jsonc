{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "notion": {
            "type": "remote",
            "url": "https://mcp.notion.com/mcp",
            "enabled": false
        },
        "kit-dev-mcp": {
            "type": "local",
            "command": [
                "uvx",
                "--from",
                "cased-kit",
                "kit-dev-mcp"
            ],
            "environment": {},
            "enabled": false
        },
        "linear": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "mcp-remote",
                "https://mcp.linear.app/mcp"
            ],
            "enabled": false
        }
    }
}
